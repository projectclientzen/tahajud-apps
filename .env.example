# Copy to .env.local. Never commit real values.
# mock = demo data with "Data demo" badge (default). live = /api/v1 (from S5).
NEXT_PUBLIC_DATA_MODE=mock
# Enables /dev/components in a production build (e2e only).
NEXT_PUBLIC_ENABLE_DEV_ROUTES=false
# Registers /sw.js outside production (production always registers it).
NEXT_PUBLIC_ENABLE_SW=false
# Mock mode only: which sign-in scenario a fresh browser starts in
# (logged_out | logged_in | purchase_pending | no_active_access | session_expired | device_limit).
# Default is logged_out. The e2e build uses logged_in.
NEXT_PUBLIC_DEMO_AUTH_SCENARIO=logged_out
# WhatsApp number of customer service, digits only with country code (example: 6281234567890).
# Empty hides the WhatsApp buttons. Needs the real number from the owner.
NEXT_PUBLIC_CS_WHATSAPP=
# Link to buy access on Scalev (https only). Empty hides the buy buttons. Needs the real link from the owner.
NEXT_PUBLIC_PURCHASE_URL=
