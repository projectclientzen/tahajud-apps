# Copy to .env.local. Never commit real values.
# mock = demo data with "Data demo" badge (default). live = /api/v1 (from S5).
NEXT_PUBLIC_DATA_MODE=mock
# Enables /dev/components in a production build (e2e only).
NEXT_PUBLIC_ENABLE_DEV_ROUTES=false
# Registers /sw.js outside production (production always registers it).
NEXT_PUBLIC_ENABLE_SW=false
# Server-only secrets (never NEXT_PUBLIC_). Set in the hosting secret manager, not in git.
# SIHAT Kemenag prayer time API token (T4 adapter). Empty = provider not configured.
SIHAT_API_TOKEN=
# Web Push VAPID (T4 sender). Generate with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Nomor WhatsApp CS untuk halaman Bantuan (angka saja, mis. 628123456789). Kosong = kontak disembunyikan.
NEXT_PUBLIC_CS_WHATSAPP=

# ---- /api/v1 backend. Server only, never NEXT_PUBLIC_. ----
# Postgres connection string (VPS Postgres). Required in live mode.
DATABASE_URL=
# Secret mixed into stored hashes (session cookies, phone proof, rate limit keys). At least 32 random characters.
# Changing it signs everyone out AND breaks activation for orders already stored (their phone hash used the old one).
SESSION_PEPPER=
# Number of reverse proxies in front of the app (1 for Caddy or nginx). The client address is that many entries from the
# END of X-Forwarded-For. Required in production. 0 = ignore the header. The proxy must overwrite the header, not pass it on.
TRUSTED_PROXY_HOPS=1
# Activation needs the phone of the order. This switch exists only so a mistake fails loudly: it cannot be turned off.
ACTIVATION_PHONE_REQUIRED=true
# Extra origins allowed to send POST/PUT/PATCH/DELETE, comma separated. The app's own host is always allowed.
APP_ORIGINS=
# Alamat publik app, dipakai membuat tautan atur password dari admin (https://domain-kamu). Kosong = alamat request admin itu sendiri.
APP_BASE_URL=
# Self-service account deletion (POST /me/delete-account). Off unless "true": access follows the purchase email,
# so deletion requests go through support for now. Data export is always on.
ACCOUNT_SELF_DELETE=false
# ---- Jobs: worker (pnpm worker) and the internal cron endpoint (POST /api/internal/cron). Server only. ----
# Shared secret for /api/internal/cron, sent as "Authorization: Bearer <secret>" or "x-cron-secret". At least 32 random
# characters. Shorter or empty = the endpoint refuses every request. The worker (pnpm worker) does not need it.
CRON_SECRET=
# Placeholder bedtime messages marked DEMO. Only honored when NODE_ENV is not production, so a production server
# can never send them. Leave "false" outside local demos.
NOTIF_ALLOW_DEMO_BANK=false
# Which provider fills prayer_times. "equran" only after permission to use EQuran.id is confirmed (PROV).
# Empty = the prayer_sync job fails with a clear message and nothing is guessed.
PRAYER_PROVIDER=

# ---- Scalev: order intake (webhook) and worker. Server only, never NEXT_PUBLIC_. ----
# Webhook endpoint to enter in the Scalev dashboard: https://<your domain>/api/v1/webhooks/scalev
# Set the signing secret and the payload key BEFORE saving the webhook there: Scalev sends a test event on save and the
# endpoint answers 503 until both exist. Webhooks need a Scalev plan that includes them (to be confirmed, B4).
# Signing secret shown by the Scalev dashboard. Empty = the webhook answers 503.
SCALEV_WEBHOOK_SIGNING_SECRET=
# Only while rotating the secret: the old one, still accepted next to the new one. Remove it afterwards.
SCALEV_WEBHOOK_SIGNING_SECRET_PREVIOUS=
# 32 random bytes, base64. Encrypts the webhook payload at rest (AES-256-GCM, kept 90 days). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes stored payloads unreadable. Empty or wrong = the webhook answers 503.
SCALEV_PAYLOAD_KEY=
# API base. Default https://api.scalev.com. Must be https (a local fake server is only accepted outside production).
SCALEV_API_BASE=
# RESTRICTED Scalev API key made for this app only: scopes order:read and order:list. Not the key Hermes uses.
# Empty = the worker cannot verify orders: events wait and the admin health page says Scalev is not configured.
SCALEV_API_KEY=
SCALEV_STORE_ID=
# Variants that grant access, comma separated. Each entry is a numeric variant id (orderlines[].variant, digits only)
# or a SKU (orderlines[].variant_sku). Mix both if you like: 5550001,TT-LIFETIME. Empty = every paid order is quarantined.
SCALEV_ALLOWED_VARIANT_IDS=
# Optional minimum net amount in IDR. Orders below it are quarantined, not given access. PROVISIONAL (price not final).
SCALEV_MIN_AMOUNT_IDR=
# The worker also lists paid orders now and then to find ones whose webhook never arrived. Set "false" to turn it off.
# The list response shape is not verified against a real Scalev account yet (NEEDS_VERIFICATION).
SCALEV_SWEEP_ENABLED=true

# Tests only. The server refuses these unless every flag is set. They are not for any real deployment.
# DB_DRIVER=pglite
# TAHAJUD_ALLOW_TEST_DB=true
# TAHAJUD_TEST_DB_SQL=tests/e2e/t3b-fixtures.sql
# Link to buy access on Scalev (https). Empty hides the buy links on login/access screens.
NEXT_PUBLIC_SCALEV_URL=
