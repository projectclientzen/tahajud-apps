    "clsx": "^2.1.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.72.0",
    "next": "15.5.29",
    "pg": "^8.23.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "tailwind-merge": "^3.7.0",
    "web-push": "^4.0.0",
