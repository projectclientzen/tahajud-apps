{"surah":105,"sha256":"6933e133dd56db778c801bf738848454e43648105a151e8d84d86a7cae39ec5f","verses":[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَـٰبِ ٱلْفِيلِ"},{"ayah":2,"text":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍ"},{"ayah":3,"text":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ"},{"ayah":4,"text":"تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ"},{"ayah":5,"text":"فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍۭ"}]}
