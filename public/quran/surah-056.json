{"surah":56,"sha256":"6933e133dd56db778c801bf738848454e43648105a151e8d84d86a7cae39ec5f","verses":[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ إِذَا وَقَعَتِ ٱلْوَاقِعَةُ"},{"ayah":2,"text":"لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ"},{"ayah":3,"text":"خَافِضَةٌ رَّافِعَةٌ"},{"ayah":4,"text":"إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّا"},{"ayah":5,"text":"وَبُسَّتِ ٱلْجِبَالُ بَسًّا"},{"ayah":6,"text":"فَكَانَتْ هَبَآءً مُّنۢبَثًّا"},{"ayah":7,"text":"وَكُنتُمْ أَزْوَٰجًا ثَلَـٰثَةً"},{"ayah":8,"text":"فَأَصْحَـٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَـٰبُ ٱلْمَيْمَنَةِ"},{"ayah":9,"text":"وَأَصْحَـٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ"},{"ayah":10,"text":"وَٱلسَّـٰبِقُونَ ٱلسَّـٰبِقُونَ"},{"ayah":11,"text":"أُو۟لَـٰٓئِكَ ٱلْمُقَرَّبُونَ"},{"ayah":12,"text":"فِى جَنَّـٰتِ ٱلنَّعِيمِ"},{"ayah":13,"text":"ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ"},{"ayah":14,"text":"وَقَلِيلٌ مِّنَ ٱلْـَٔاخِرِينَ"},{"ayah":15,"text":"عَلَىٰ سُرُرٍ مَّوْضُونَةٍ"},{"ayah":16,"text":"مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَـٰبِلِينَ"},{"ayah":17,"text":"يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌ مُّخَلَّدُونَ"},{"ayah":18,"text":"بِأَكْوَابٍ وَأَبَارِيقَ وَكَأْسٍ مِّن مَّعِينٍ"},{"ayah":19,"text":"لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ"},{"ayah":20,"text":"وَفَـٰكِهَةٍ مِّمَّا يَتَخَيَّرُونَ"},{"ayah":21,"text":"وَلَحْمِ طَيْرٍ مِّمَّا يَشْتَهُونَ"},{"ayah":22,"text":"وَحُورٌ عِينٌ"},{"ayah":23,"text":"كَأَمْثَـٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ"},{"ayah":24,"text":"جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ"},{"ayah":25,"text":"لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا تَأْثِيمًا"},{"ayah":26,"text":"إِلَّا قِيلًا سَلَـٰمًا سَلَـٰمًا"},{"ayah":27,"text":"وَأَصْحَـٰبُ ٱلْيَمِينِ مَآ أَصْحَـٰبُ ٱلْيَمِينِ"},{"ayah":28,"text":"فِى سِدْرٍ مَّخْضُودٍ"},{"ayah":29,"text":"وَطَلْحٍ مَّنضُودٍ"},{"ayah":30,"text":"وَظِلٍّ مَّمْدُودٍ"},{"ayah":31,"text":"وَمَآءٍ مَّسْكُوبٍ"},{"ayah":32,"text":"وَفَـٰكِهَةٍ كَثِيرَةٍ"},{"ayah":33,"text":"لَّا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍ"},{"ayah":34,"text":"وَفُرُشٍ مَّرْفُوعَةٍ"},{"ayah":35,"text":"إِنَّآ أَنشَأْنَـٰهُنَّ إِنشَآءً"},{"ayah":36,"text":"فَجَعَلْنَـٰهُنَّ أَبْكَارًا"},{"ayah":37,"text":"عُرُبًا أَتْرَابًا"},{"ayah":38,"text":"لِّأَصْحَـٰبِ ٱلْيَمِينِ"},{"ayah":39,"text":"ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ"},{"ayah":40,"text":"وَثُلَّةٌ مِّنَ ٱلْـَٔاخِرِينَ"},{"ayah":41,"text":"وَأَصْحَـٰبُ ٱلشِّمَالِ مَآ أَصْحَـٰبُ ٱلشِّمَالِ"},{"ayah":42,"text":"فِى سَمُومٍ وَحَمِيمٍ"},{"ayah":43,"text":"وَظِلٍّ مِّن يَحْمُومٍ"},{"ayah":44,"text":"لَّا بَارِدٍ وَلَا كَرِيمٍ"},{"ayah":45,"text":"إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ"},{"ayah":46,"text":"وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ"},{"ayah":47,"text":"وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ"},{"ayah":48,"text":"أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ"},{"ayah":49,"text":"قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْـَٔاخِرِينَ"},{"ayah":50,"text":"لَمَجْمُوعُونَ إِلَىٰ مِيقَـٰتِ يَوْمٍ مَّعْلُومٍ"},{"ayah":51,"text":"ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ"},{"ayah":52,"text":"لَـَٔاكِلُونَ مِن شَجَرٍ مِّن زَقُّومٍ"},{"ayah":53,"text":"فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ"},{"ayah":54,"text":"فَشَـٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ"},{"ayah":55,"text":"فَشَـٰرِبُونَ شُرْبَ ٱلْهِيمِ"},{"ayah":56,"text":"هَـٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ"},{"ayah":57,"text":"نَحْنُ خَلَقْنَـٰكُمْ فَلَوْلَا تُصَدِّقُونَ"},{"ayah":58,"text":"أَفَرَءَيْتُم مَّا تُمْنُونَ"},{"ayah":59,"text":"ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَـٰلِقُونَ"},{"ayah":60,"text":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ"},{"ayah":61,"text":"عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَـٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ"},{"ayah":62,"text":"وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ"},{"ayah":63,"text":"أَفَرَءَيْتُم مَّا تَحْرُثُونَ"},{"ayah":64,"text":"ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ"},{"ayah":65,"text":"لَوْ نَشَآءُ لَجَعَلْنَـٰهُ حُطَـٰمًا فَظَلْتُمْ تَفَكَّهُونَ"},{"ayah":66,"text":"إِنَّا لَمُغْرَمُونَ"},{"ayah":67,"text":"بَلْ نَحْنُ مَحْرُومُونَ"},{"ayah":68,"text":"أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ"},{"ayah":69,"text":"ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ"},{"ayah":70,"text":"لَوْ نَشَآءُ جَعَلْنَـٰهُ أُجَاجًا فَلَوْلَا تَشْكُرُونَ"},{"ayah":71,"text":"أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ"},{"ayah":72,"text":"ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ"},{"ayah":73,"text":"نَحْنُ جَعَلْنَـٰهَا تَذْكِرَةً وَمَتَـٰعًا لِّلْمُقْوِينَ"},{"ayah":74,"text":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ"},{"ayah":75,"text":"فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ"},{"ayah":76,"text":"وَإِنَّهُۥ لَقَسَمٌ لَّوْ تَعْلَمُونَ عَظِيمٌ"},{"ayah":77,"text":"إِنَّهُۥ لَقُرْءَانٌ كَرِيمٌ"},{"ayah":78,"text":"فِى كِتَـٰبٍ مَّكْنُونٍ"},{"ayah":79,"text":"لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ"},{"ayah":80,"text":"تَنزِيلٌ مِّن رَّبِّ ٱلْعَـٰلَمِينَ"},{"ayah":81,"text":"أَفَبِهَـٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ"},{"ayah":82,"text":"وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ"},{"ayah":83,"text":"فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ"},{"ayah":84,"text":"وَأَنتُمْ حِينَئِذٍ تَنظُرُونَ"},{"ayah":85,"text":"وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَـٰكِن لَّا تُبْصِرُونَ"},{"ayah":86,"text":"فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ"},{"ayah":87,"text":"تَرْجِعُونَهَآ إِن كُنتُمْ صَـٰدِقِينَ"},{"ayah":88,"text":"فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ"},{"ayah":89,"text":"فَرَوْحٌ وَرَيْحَانٌ وَجَنَّتُ نَعِيمٍ"},{"ayah":90,"text":"وَأَمَّآ إِن كَانَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ"},{"ayah":91,"text":"فَسَلَـٰمٌ لَّكَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ"},{"ayah":92,"text":"وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ"},{"ayah":93,"text":"فَنُزُلٌ مِّنْ حَمِيمٍ"},{"ayah":94,"text":"وَتَصْلِيَةُ جَحِيمٍ"},{"ayah":95,"text":"إِنَّ هَـٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ"},{"ayah":96,"text":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ"}]}
