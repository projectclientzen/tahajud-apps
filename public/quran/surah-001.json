{"surah":1,"sha256":"6933e133dd56db778c801bf738848454e43648105a151e8d84d86a7cae39ec5f","verses":[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ"},{"ayah":2,"text":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ"},{"ayah":3,"text":"ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ"},{"ayah":4,"text":"مَـٰلِكِ يَوْمِ ٱلدِّينِ"},{"ayah":5,"text":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ"},{"ayah":6,"text":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ"},{"ayah":7,"text":"صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ"}]}
