{"surah":102,"sha256":"6933e133dd56db778c801bf738848454e43648105a151e8d84d86a7cae39ec5f","verses":[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ"},{"ayah":2,"text":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ"},{"ayah":3,"text":"كَلَّا سَوْفَ تَعْلَمُونَ"},{"ayah":4,"text":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ"},{"ayah":5,"text":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ"},{"ayah":6,"text":"لَتَرَوُنَّ ٱلْجَحِيمَ"},{"ayah":7,"text":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ"},{"ayah":8,"text":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ"}]}
