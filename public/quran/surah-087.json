{"surah":87,"sha256":"6933e133dd56db778c801bf738848454e43648105a151e8d84d86a7cae39ec5f","verses":[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى"},{"ayah":2,"text":"ٱلَّذِى خَلَقَ فَسَوَّىٰ"},{"ayah":3,"text":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ"},{"ayah":4,"text":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ"},{"ayah":5,"text":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ"},{"ayah":6,"text":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ"},{"ayah":7,"text":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ"},{"ayah":8,"text":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ"},{"ayah":9,"text":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ"},{"ayah":10,"text":"سَيَذَّكَّرُ مَن يَخْشَىٰ"},{"ayah":11,"text":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى"},{"ayah":12,"text":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ"},{"ayah":13,"text":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ"},{"ayah":14,"text":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ"},{"ayah":15,"text":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ"},{"ayah":16,"text":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا"},{"ayah":17,"text":"وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ"},{"ayah":18,"text":"إِنَّ هَـٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ"},{"ayah":19,"text":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ"}]}
