{"surah":104,"sha256":"6933e133dd56db778c801bf738848454e43648105a151e8d84d86a7cae39ec5f","verses":[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ"},{"ayah":2,"text":"ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ"},{"ayah":3,"text":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ"},{"ayah":4,"text":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ"},{"ayah":5,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ"},{"ayah":6,"text":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ"},{"ayah":7,"text":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ"},{"ayah":8,"text":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ"},{"ayah":9,"text":"فِى عَمَدٍ مُّمَدَّدَةٍۭ"}]}
