{"surah":84,"sha256":"6933e133dd56db778c801bf738848454e43648105a151e8d84d86a7cae39ec5f","verses":[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ"},{"ayah":2,"text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},{"ayah":3,"text":"وَإِذَا ٱلْأَرْضُ مُدَّتْ"},{"ayah":4,"text":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ"},{"ayah":5,"text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},{"ayah":6,"text":"يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَـٰقِيهِ"},{"ayah":7,"text":"فَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ"},{"ayah":8,"text":"فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا"},{"ayah":9,"text":"وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًا"},{"ayah":10,"text":"وَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ وَرَآءَ ظَهْرِهِۦ"},{"ayah":11,"text":"فَسَوْفَ يَدْعُوا۟ ثُبُورًا"},{"ayah":12,"text":"وَيَصْلَىٰ سَعِيرًا"},{"ayah":13,"text":"إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا"},{"ayah":14,"text":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ"},{"ayah":15,"text":"بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا"},{"ayah":16,"text":"فَلَآ أُقْسِمُ بِٱلشَّفَقِ"},{"ayah":17,"text":"وَٱلَّيْلِ وَمَا وَسَقَ"},{"ayah":18,"text":"وَٱلْقَمَرِ إِذَا ٱتَّسَقَ"},{"ayah":19,"text":"لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ"},{"ayah":20,"text":"فَمَا لَهُمْ لَا يُؤْمِنُونَ"},{"ayah":21,"text":"وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩"},{"ayah":22,"text":"بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ"},{"ayah":23,"text":"وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ"},{"ayah":24,"text":"فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ"},{"ayah":25,"text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ"}]}
