{"surah":114,"sha256":"6933e133dd56db778c801bf738848454e43648105a151e8d84d86a7cae39ec5f","verses":[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ"},{"ayah":2,"text":"مَلِكِ ٱلنَّاسِ"},{"ayah":3,"text":"إِلَـٰهِ ٱلنَّاسِ"},{"ayah":4,"text":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ"},{"ayah":5,"text":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ"},{"ayah":6,"text":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ"}]}
