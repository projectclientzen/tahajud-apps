{"surah":77,"sha256":"6933e133dd56db778c801bf738848454e43648105a151e8d84d86a7cae39ec5f","verses":[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَـٰتِ عُرْفًا"},{"ayah":2,"text":"فَٱلْعَـٰصِفَـٰتِ عَصْفًا"},{"ayah":3,"text":"وَٱلنَّـٰشِرَٰتِ نَشْرًا"},{"ayah":4,"text":"فَٱلْفَـٰرِقَـٰتِ فَرْقًا"},{"ayah":5,"text":"فَٱلْمُلْقِيَـٰتِ ذِكْرًا"},{"ayah":6,"text":"عُذْرًا أَوْ نُذْرًا"},{"ayah":7,"text":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ"},{"ayah":8,"text":"فَإِذَا ٱلنُّجُومُ طُمِسَتْ"},{"ayah":9,"text":"وَإِذَا ٱلسَّمَآءُ فُرِجَتْ"},{"ayah":10,"text":"وَإِذَا ٱلْجِبَالُ نُسِفَتْ"},{"ayah":11,"text":"وَإِذَا ٱلرُّسُلُ أُقِّتَتْ"},{"ayah":12,"text":"لِأَىِّ يَوْمٍ أُجِّلَتْ"},{"ayah":13,"text":"لِيَوْمِ ٱلْفَصْلِ"},{"ayah":14,"text":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ"},{"ayah":15,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"ayah":16,"text":"أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ"},{"ayah":17,"text":"ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ"},{"ayah":18,"text":"كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ"},{"ayah":19,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"ayah":20,"text":"أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ"},{"ayah":21,"text":"فَجَعَلْنَـٰهُ فِى قَرَارٍ مَّكِينٍ"},{"ayah":22,"text":"إِلَىٰ قَدَرٍ مَّعْلُومٍ"},{"ayah":23,"text":"فَقَدَرْنَا فَنِعْمَ ٱلْقَـٰدِرُونَ"},{"ayah":24,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"ayah":25,"text":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا"},{"ayah":26,"text":"أَحْيَآءً وَأَمْوَٰتًا"},{"ayah":27,"text":"وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَـٰمِخَـٰتٍ وَأَسْقَيْنَـٰكُم مَّآءً فُرَاتًا"},{"ayah":28,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"ayah":29,"text":"ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ"},{"ayah":30,"text":"ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَـٰثِ شُعَبٍ"},{"ayah":31,"text":"لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ"},{"ayah":32,"text":"إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ"},{"ayah":33,"text":"كَأَنَّهُۥ جِمَـٰلَتٌ صُفْرٌ"},{"ayah":34,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"ayah":35,"text":"هَـٰذَا يَوْمُ لَا يَنطِقُونَ"},{"ayah":36,"text":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ"},{"ayah":37,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"ayah":38,"text":"هَـٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَـٰكُمْ وَٱلْأَوَّلِينَ"},{"ayah":39,"text":"فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ"},{"ayah":40,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"ayah":41,"text":"إِنَّ ٱلْمُتَّقِينَ فِى ظِلَـٰلٍ وَعُيُونٍ"},{"ayah":42,"text":"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ"},{"ayah":43,"text":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ"},{"ayah":44,"text":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"},{"ayah":45,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"ayah":46,"text":"كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ"},{"ayah":47,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"ayah":48,"text":"وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ"},{"ayah":49,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"},{"ayah":50,"text":"فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ"}]}
