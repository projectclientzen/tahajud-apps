{"surah":96,"sha256":"6933e133dd56db778c801bf738848454e43648105a151e8d84d86a7cae39ec5f","verses":[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ"},{"ayah":2,"text":"خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ"},{"ayah":3,"text":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ"},{"ayah":4,"text":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ"},{"ayah":5,"text":"عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ"},{"ayah":6,"text":"كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ"},{"ayah":7,"text":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ"},{"ayah":8,"text":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ"},{"ayah":9,"text":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ"},{"ayah":10,"text":"عَبْدًا إِذَا صَلَّىٰٓ"},{"ayah":11,"text":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ"},{"ayah":12,"text":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ"},{"ayah":13,"text":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ"},{"ayah":14,"text":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ"},{"ayah":15,"text":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ"},{"ayah":16,"text":"نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ"},{"ayah":17,"text":"فَلْيَدْعُ نَادِيَهُۥ"},{"ayah":18,"text":"سَنَدْعُ ٱلزَّبَانِيَةَ"},{"ayah":19,"text":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩"}]}
