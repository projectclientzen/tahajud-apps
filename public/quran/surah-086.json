{"surah":86,"sha256":"6933e133dd56db778c801bf738848454e43648105a151e8d84d86a7cae39ec5f","verses":[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ"},{"ayah":2,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ"},{"ayah":3,"text":"ٱلنَّجْمُ ٱلثَّاقِبُ"},{"ayah":4,"text":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ"},{"ayah":5,"text":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ"},{"ayah":6,"text":"خُلِقَ مِن مَّآءٍ دَافِقٍ"},{"ayah":7,"text":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ"},{"ayah":8,"text":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ"},{"ayah":9,"text":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ"},{"ayah":10,"text":"فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ"},{"ayah":11,"text":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ"},{"ayah":12,"text":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ"},{"ayah":13,"text":"إِنَّهُۥ لَقَوْلٌ فَصْلٌ"},{"ayah":14,"text":"وَمَا هُوَ بِٱلْهَزْلِ"},{"ayah":15,"text":"إِنَّهُمْ يَكِيدُونَ كَيْدًا"},{"ayah":16,"text":"وَأَكِيدُ كَيْدًا"},{"ayah":17,"text":"فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا"}]}
