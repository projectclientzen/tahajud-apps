{"surah":100,"sha256":"6933e133dd56db778c801bf738848454e43648105a151e8d84d86a7cae39ec5f","verses":[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلْعَـٰدِيَـٰتِ ضَبْحًا"},{"ayah":2,"text":"فَٱلْمُورِيَـٰتِ قَدْحًا"},{"ayah":3,"text":"فَٱلْمُغِيرَٰتِ صُبْحًا"},{"ayah":4,"text":"فَأَثَرْنَ بِهِۦ نَقْعًا"},{"ayah":5,"text":"فَوَسَطْنَ بِهِۦ جَمْعًا"},{"ayah":6,"text":"إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌ"},{"ayah":7,"text":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ"},{"ayah":8,"text":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ"},{"ayah":9,"text":"أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ"},{"ayah":10,"text":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ"},{"ayah":11,"text":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ"}]}
