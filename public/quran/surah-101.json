{"surah":101,"sha256":"6933e133dd56db778c801bf738848454e43648105a151e8d84d86a7cae39ec5f","verses":[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ"},{"ayah":2,"text":"مَا ٱلْقَارِعَةُ"},{"ayah":3,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ"},{"ayah":4,"text":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ"},{"ayah":5,"text":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ"},{"ayah":6,"text":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ"},{"ayah":7,"text":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ"},{"ayah":8,"text":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ"},{"ayah":9,"text":"فَأُمُّهُۥ هَاوِيَةٌ"},{"ayah":10,"text":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ"},{"ayah":11,"text":"نَارٌ حَامِيَةٌۢ"}]}
