{"surah":109,"sha256":"6933e133dd56db778c801bf738848454e43648105a151e8d84d86a7cae39ec5f","verses":[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ قُلْ يَـٰٓأَيُّهَا ٱلْكَـٰفِرُونَ"},{"ayah":2,"text":"لَآ أَعْبُدُ مَا تَعْبُدُونَ"},{"ayah":3,"text":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ"},{"ayah":4,"text":"وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمْ"},{"ayah":5,"text":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ"},{"ayah":6,"text":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ"}]}
