{"surah":107,"sha256":"6933e133dd56db778c801bf738848454e43648105a151e8d84d86a7cae39ec5f","verses":[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ"},{"ayah":2,"text":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ"},{"ayah":3,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"},{"ayah":4,"text":"فَوَيْلٌ لِّلْمُصَلِّينَ"},{"ayah":5,"text":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ"},{"ayah":6,"text":"ٱلَّذِينَ هُمْ يُرَآءُونَ"},{"ayah":7,"text":"وَيَمْنَعُونَ ٱلْمَاعُونَ"}]}
