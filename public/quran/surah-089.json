{"surah":89,"sha256":"6933e133dd56db778c801bf738848454e43648105a151e8d84d86a7cae39ec5f","verses":[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلْفَجْرِ"},{"ayah":2,"text":"وَلَيَالٍ عَشْرٍ"},{"ayah":3,"text":"وَٱلشَّفْعِ وَٱلْوَتْرِ"},{"ayah":4,"text":"وَٱلَّيْلِ إِذَا يَسْرِ"},{"ayah":5,"text":"هَلْ فِى ذَٰلِكَ قَسَمٌ لِّذِى حِجْرٍ"},{"ayah":6,"text":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ"},{"ayah":7,"text":"إِرَمَ ذَاتِ ٱلْعِمَادِ"},{"ayah":8,"text":"ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَـٰدِ"},{"ayah":9,"text":"وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ"},{"ayah":10,"text":"وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ"},{"ayah":11,"text":"ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَـٰدِ"},{"ayah":12,"text":"فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ"},{"ayah":13,"text":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ"},{"ayah":14,"text":"إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ"},{"ayah":15,"text":"فَأَمَّا ٱلْإِنسَـٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ"},{"ayah":16,"text":"وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَـٰنَنِ"},{"ayah":17,"text":"كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ"},{"ayah":18,"text":"وَلَا تَحَـٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"},{"ayah":19,"text":"وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا"},{"ayah":20,"text":"وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا"},{"ayah":21,"text":"كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا"},{"ayah":22,"text":"وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا"},{"ayah":23,"text":"وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍ يَتَذَكَّرُ ٱلْإِنسَـٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ"},{"ayah":24,"text":"يَقُولُ يَـٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى"},{"ayah":25,"text":"فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ"},{"ayah":26,"text":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ"},{"ayah":27,"text":"يَـٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ"},{"ayah":28,"text":"ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً"},{"ayah":29,"text":"فَٱدْخُلِى فِى عِبَـٰدِى"},{"ayah":30,"text":"وَٱدْخُلِى جَنَّتِى"}]}
