{"surah":79,"sha256":"6933e133dd56db778c801bf738848454e43648105a151e8d84d86a7cae39ec5f","verses":[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلنَّـٰزِعَـٰتِ غَرْقًا"},{"ayah":2,"text":"وَٱلنَّـٰشِطَـٰتِ نَشْطًا"},{"ayah":3,"text":"وَٱلسَّـٰبِحَـٰتِ سَبْحًا"},{"ayah":4,"text":"فَٱلسَّـٰبِقَـٰتِ سَبْقًا"},{"ayah":5,"text":"فَٱلْمُدَبِّرَٰتِ أَمْرًا"},{"ayah":6,"text":"يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ"},{"ayah":7,"text":"تَتْبَعُهَا ٱلرَّادِفَةُ"},{"ayah":8,"text":"قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ"},{"ayah":9,"text":"أَبْصَـٰرُهَا خَـٰشِعَةٌ"},{"ayah":10,"text":"يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ"},{"ayah":11,"text":"أَءِذَا كُنَّا عِظَـٰمًا نَّخِرَةً"},{"ayah":12,"text":"قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ"},{"ayah":13,"text":"فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ"},{"ayah":14,"text":"فَإِذَا هُم بِٱلسَّاهِرَةِ"},{"ayah":15,"text":"هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ"},{"ayah":16,"text":"إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى"},{"ayah":17,"text":"ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ"},{"ayah":18,"text":"فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ"},{"ayah":19,"text":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ"},{"ayah":20,"text":"فَأَرَىٰهُ ٱلْـَٔايَةَ ٱلْكُبْرَىٰ"},{"ayah":21,"text":"فَكَذَّبَ وَعَصَىٰ"},{"ayah":22,"text":"ثُمَّ أَدْبَرَ يَسْعَىٰ"},{"ayah":23,"text":"فَحَشَرَ فَنَادَىٰ"},{"ayah":24,"text":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ"},{"ayah":25,"text":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ وَٱلْأُولَىٰٓ"},{"ayah":26,"text":"إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ"},{"ayah":27,"text":"ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا"},{"ayah":28,"text":"رَفَعَ سَمْكَهَا فَسَوَّىٰهَا"},{"ayah":29,"text":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا"},{"ayah":30,"text":"وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ"},{"ayah":31,"text":"أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا"},{"ayah":32,"text":"وَٱلْجِبَالَ أَرْسَىٰهَا"},{"ayah":33,"text":"مَتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ"},{"ayah":34,"text":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ"},{"ayah":35,"text":"يَوْمَ يَتَذَكَّرُ ٱلْإِنسَـٰنُ مَا سَعَىٰ"},{"ayah":36,"text":"وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ"},{"ayah":37,"text":"فَأَمَّا مَن طَغَىٰ"},{"ayah":38,"text":"وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا"},{"ayah":39,"text":"فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ"},{"ayah":40,"text":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ"},{"ayah":41,"text":"فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ"},{"ayah":42,"text":"يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا"},{"ayah":43,"text":"فِيمَ أَنتَ مِن ذِكْرَىٰهَآ"},{"ayah":44,"text":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ"},{"ayah":45,"text":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا"},{"ayah":46,"text":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا"}]}
