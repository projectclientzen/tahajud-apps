{"surah":113,"sha256":"6933e133dd56db778c801bf738848454e43648105a151e8d84d86a7cae39ec5f","verses":[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ"},{"ayah":2,"text":"مِن شَرِّ مَا خَلَقَ"},{"ayah":3,"text":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ"},{"ayah":4,"text":"وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ"},{"ayah":5,"text":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ"}]}
