{"surah":81,"sha256":"6933e133dd56db778c801bf738848454e43648105a151e8d84d86a7cae39ec5f","verses":[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ"},{"ayah":2,"text":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ"},{"ayah":3,"text":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ"},{"ayah":4,"text":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ"},{"ayah":5,"text":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ"},{"ayah":6,"text":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ"},{"ayah":7,"text":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ"},{"ayah":8,"text":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ"},{"ayah":9,"text":"بِأَىِّ ذَنۢبٍ قُتِلَتْ"},{"ayah":10,"text":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ"},{"ayah":11,"text":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ"},{"ayah":12,"text":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ"},{"ayah":13,"text":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ"},{"ayah":14,"text":"عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ"},{"ayah":15,"text":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ"},{"ayah":16,"text":"ٱلْجَوَارِ ٱلْكُنَّسِ"},{"ayah":17,"text":"وَٱلَّيْلِ إِذَا عَسْعَسَ"},{"ayah":18,"text":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ"},{"ayah":19,"text":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ"},{"ayah":20,"text":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ"},{"ayah":21,"text":"مُّطَاعٍ ثَمَّ أَمِينٍ"},{"ayah":22,"text":"وَمَا صَاحِبُكُم بِمَجْنُونٍ"},{"ayah":23,"text":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ"},{"ayah":24,"text":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ"},{"ayah":25,"text":"وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ"},{"ayah":26,"text":"فَأَيْنَ تَذْهَبُونَ"},{"ayah":27,"text":"إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ"},{"ayah":28,"text":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ"},{"ayah":29,"text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ"}]}
