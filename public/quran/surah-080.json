{"surah":80,"sha256":"6933e133dd56db778c801bf738848454e43648105a151e8d84d86a7cae39ec5f","verses":[{"ayah":1,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ"},{"ayah":2,"text":"أَن جَآءَهُ ٱلْأَعْمَىٰ"},{"ayah":3,"text":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ"},{"ayah":4,"text":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ"},{"ayah":5,"text":"أَمَّا مَنِ ٱسْتَغْنَىٰ"},{"ayah":6,"text":"فَأَنتَ لَهُۥ تَصَدَّىٰ"},{"ayah":7,"text":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ"},{"ayah":8,"text":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ"},{"ayah":9,"text":"وَهُوَ يَخْشَىٰ"},{"ayah":10,"text":"فَأَنتَ عَنْهُ تَلَهَّىٰ"},{"ayah":11,"text":"كَلَّآ إِنَّهَا تَذْكِرَةٌ"},{"ayah":12,"text":"فَمَن شَآءَ ذَكَرَهُۥ"},{"ayah":13,"text":"فِى صُحُفٍ مُّكَرَّمَةٍ"},{"ayah":14,"text":"مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ"},{"ayah":15,"text":"بِأَيْدِى سَفَرَةٍ"},{"ayah":16,"text":"كِرَامٍۭ بَرَرَةٍ"},{"ayah":17,"text":"قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ"},{"ayah":18,"text":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ"},{"ayah":19,"text":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ"},{"ayah":20,"text":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ"},{"ayah":21,"text":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ"},{"ayah":22,"text":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ"},{"ayah":23,"text":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ"},{"ayah":24,"text":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ"},{"ayah":25,"text":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا"},{"ayah":26,"text":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا"},{"ayah":27,"text":"فَأَنۢبَتْنَا فِيهَا حَبًّا"},{"ayah":28,"text":"وَعِنَبًا وَقَضْبًا"},{"ayah":29,"text":"وَزَيْتُونًا وَنَخْلًا"},{"ayah":30,"text":"وَحَدَآئِقَ غُلْبًا"},{"ayah":31,"text":"وَفَـٰكِهَةً وَأَبًّا"},{"ayah":32,"text":"مَّتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ"},{"ayah":33,"text":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ"},{"ayah":34,"text":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ"},{"ayah":35,"text":"وَأُمِّهِۦ وَأَبِيهِ"},{"ayah":36,"text":"وَصَـٰحِبَتِهِۦ وَبَنِيهِ"},{"ayah":37,"text":"لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ"},{"ayah":38,"text":"وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ"},{"ayah":39,"text":"ضَاحِكَةٌ مُّسْتَبْشِرَةٌ"},{"ayah":40,"text":"وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ"},{"ayah":41,"text":"تَرْهَقُهَا قَتَرَةٌ"},{"ayah":42,"text":"أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ"}]}
